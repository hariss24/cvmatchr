# Supabase — optionnel : sans ces variables, l'app tourne en mode 100 % local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Client ID Google OAuth — public par conception. Active le flux Google Identity
# Services, qui fait afficher votre domaine par Google au lieu de celui de
# Supabase. Absent : repli sur la redirection Supabase classique (fonctionne,
# mais l'écran Google montre le domaine <ref>.supabase.co).
# À coller aussi dans Supabase > Authentication > Google > « Client IDs ».
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Clé IA du serveur, réservée aux utilisateurs connectés dans leur quota.
# JAMAIS de préfixe NEXT_PUBLIC_ : elle serait exposée dans le navigateur.
GEMINI_API_KEY=
# Le modèle employé avec cette clé n'est pas réglable : il est figé dans
# `src/lib/ai/guard.ts` (SERVER_MODEL). Un ancien `AI_SERVER_MODEL` resté dans
# l'environnement est désormais ignoré.

# Logos d'entreprise sur les offres (Brand Search API de Brandfetch, gratuite).
# Absente : les offres affichent l'initiale de l'entreprise à la place du logo.
BRANDFETCH_CLIENT_ID=

# Clé d'administration Supabase (Project Settings > API > service_role).
# JAMAIS de préfixe NEXT_PUBLIC_ : elle contourne toutes les règles de sécurité
# de la base et serait exposée dans le navigateur.
# Sert uniquement à reconnaître qu'une adresse a été inscrite via Google, pour
# orienter la personne vers le bon bouton (/api/auth/methode). Absente : ce cas
# n'est pas reconnu, l'app affiche un message générique et rien ne casse.
SUPABASE_SERVICE_ROLE_KEY=
